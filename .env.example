# Application Server
PORT=5000
SERVER_BASE_URL=http://localhost:5000
CLIENT_CORS_URL=http://localhost:3000

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/fashion_ecommerce
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT Authentication
ACCESS_TOKEN_SECRET=your_jwt_access_secret_min_256_bits
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_256_bits
REFRESH_TOKEN_EXPIRES_IN=1d

# SePay Payment Gateway
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_ACCOUNT_NUMBER=your_sepay_bank_account_number
SEPAY_BANK_CODE=MBBank
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret

# Upload Directory (Local fallback)
UPLOAD_DIR=uploads

# S3 Cloud Storage (Supabase Storage / AWS S3)
S3_ENDPOINT=https://kqerbvhdttbncfydmuii.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=fashion-uploads

# Mail Service (Brevo API & Gmail SMTP fallback)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_email@gmail.com
BREVO_SENDER_NAME="Fashion Store"
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password